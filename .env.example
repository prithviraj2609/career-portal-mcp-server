CAREER_PORTAL_REQUEST_TIMEOUT_MS=10000
CAREER_PORTAL_MAX_RESULTS=25
CAREER_PORTAL_READS_PER_MINUTE=20
CAREER_PORTAL_MUTATIONS_ENABLED=false
CAREER_PORTAL_MUTATION_CONFIRMATION_TTL_MS=300000
CAREER_PORTAL_LINKEDIN_BROWSER_ENABLED=false
CAREER_PORTAL_NAUKRI_BROWSER_ENABLED=false
CAREER_PORTAL_RESUME_MAX_BYTES=5242880
# Required when the Naukri browser adapter is enabled.
# CAREER_PORTAL_RESUME_DIRECTORY=C:\Users\me\Documents\Resumes
# Optional 32-byte base64 key for encrypted session persistence.
# Preferred by the secure launcher; do not put the key itself in MCP config.
# CAREER_PORTAL_SESSION_KEY_FILE=/absolute/path/to/session.key
# CAREER_PORTAL_SESSION_KEY=
# CAREER_PORTAL_SESSION_FILE=
# User agent must identify this client; include a support contact in managed deployments.
CAREER_PORTAL_USER_AGENT=CareerPortalMCP/0.1
