{
  "name": "career-portal-mcp-server",
  "version": "0.1.0",
  "description": "First-party MCP server for safe LinkedIn and Naukri job discovery and opt-in account management",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "career-portal-mcp": "./dist/index.js",
    "career-portal-mcp-secure": "./dist/secure-launcher.js"
  },
  "files": [
    "dist/",
    "config/",
    "docs/",
    ".env.example",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:secure": "node dist/secure-launcher.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "pack:verify": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.8",
    "eslint": "^9.37.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "prithviraj2609",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prithviraj2609/career-portal-mcp-server.git"
  },
  "homepage": "https://github.com/prithviraj2609/career-portal-mcp-server",
  "bugs": {
    "url": "https://github.com/prithviraj2609/career-portal-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "linkedin",
    "naukri",
    "jobs",
    "career"
  ]
}
